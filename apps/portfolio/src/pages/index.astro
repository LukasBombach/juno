---                            
import '../styles/global.css'  
--- 


<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body class="p-40 grid gap-16 bg-zinc-50 dark:bg-[#24272D] dark:text-neutral-300">
		<header class="grid gap-2">
			<h1 class="font-medium font-serif italic">Lukas Bombach</h1>
			<p>
				I'm a web developer from Berlin, Germany
				<br />
				You can find me on <a href="https://github.com/LukasBombach" class="underline decoration-neutral-300 hover:text-blue-600 dark:hover:text-blue-500 hover:decoration-current transition-colors" rel="nofollow">GitHub</a>
			</p>
		</header>

		<main class="grid gap-2">
			<h2 class="font-medium font-serif italic">Articles</h2>
			<ul class="grid gap-2">
				<li class="grid items-baseline grid-flow-col-dense justify-start gap-4 leading-7">
					<time datetime="2025-12" class="uppercase text-xs font-semibold text-neutral-400">2025 Dec</time>
					<a class="underline decoration-neutral-300 hover:text-blue-600 dark:hover:text-blue-500 hover:decoration-current transition-colors" href="/syntax-highlighting-with-just-two-html-elements">
						Syntax highlighting with just two html elements
					</a>
				</li>
				<li class="grid items-baseline grid-flow-col-dense justify-start gap-4 leading-7">
					<time datetime="2020-02" class="uppercase text-xs font-semibold text-neutral-400">2020 Feb</time>
					<a class="underline decoration-neutral-300 hover:text-blue-600 dark:hover:text-blue-500 hover:decoration-current transition-colors" href="https://dev.to/lukasbombach/how-to-write-a-tree-shakable-component-library-4ied" rel="nofollow">
						How to write a tree-shakable component library (on dev.to)
					</a>
				</li>
				<li class="grid items-baseline grid-flow-col-dense justify-start gap-4 leading-7">
					<time datetime="2019-05" class="uppercase text-xs font-semibold text-neutral-400">2019 May</time>
					<a class="underline decoration-neutral-300 hover:text-blue-600 dark:hover:text-blue-500 hover:decoration-current transition-colors" href="https://medium.com/@luke_schmuke/how-we-achieved-the-best-web-performance-with-partial-hydration-20fab9c808d5" rel="nofollow">
						The case of partial hydration (on medium.com)
					</a>
				</li>
			</ul>
		</main>
	</body>
</html>
